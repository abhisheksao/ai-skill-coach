# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# Neo4j Aura
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM (Constitution VI: tier/model switch is config-only)
GOOGLE_API_KEY=
# Pinned (2026-07-13): best free-tier RPD (500/day vs 20 for 3.5-flash).
# Re-check quotas in AI Studio before changing.
LLM_MODEL=gemini-3.1-flash-lite
DAILY_LLM_BUDGET=50

# App
# Shared secret for the pg_cron-triggered /v1/internal/* endpoints.
# Must match the X-Internal-Secret the Supabase cron jobs send.
INTERNAL_SECRET=
CORS_ORIGINS=http://localhost:8081
POLICY_URL=https://example.com/skillcoach-policy
GIT_SHA=dev
