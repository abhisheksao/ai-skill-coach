{
  "name": "@abhisheksao/ai-skill-coach-core",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "description": "Reusable Expo building blocks for AI coaching apps: Supabase auth + OAuth, API client, voice session, design tokens, base components.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhisheksao/ai-skill-coach.git",
    "directory": "app/packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src",
    "NOTICE",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "exports": {
    "./api-client": "./src/api-client.ts",
    "./oauth": "./src/oauth.ts",
    "./supabase": "./src/supabase.ts",
    "./theme": "./src/theme/tokens.ts",
    "./use-voice-session": "./src/use-voice-session.ts",
    "./voice-capabilities": "./src/voice-capabilities.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "@supabase/supabase-js": "*",
    "expo-apple-authentication": "*",
    "expo-auth-session": "*",
    "expo-device": "*",
    "expo-speech": "*",
    "expo-speech-recognition": "*",
    "expo-web-browser": "*",
    "react": "*",
    "react-i18next": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*"
  }
}
