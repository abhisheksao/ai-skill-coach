{
  "name": "app",
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*"
  ],
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.110.2",
    "@types/jest": "29.5.14",
    "expo": "~57.0.4",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.15",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.3.6",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.9",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "neo4j-driver": "^6.2.0",
    "serve": "^14.2.6",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "e2e:build": "expo export --platform web --clear",
    "e2e:serve": "npx serve dist -l 4021 -s",
    "e2e": "npm run e2e:build && playwright test",
    "e2e:seed": "npx tsx e2e/playwright/support/seed-test-users.ts"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-apple-authentication",
          "expo-notifications"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e/"
    ]
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
