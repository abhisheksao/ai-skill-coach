EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Physical devices must reach your machine over LAN
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
# EAS project id (004, push notifications) -- reference only; the actual
# runtime source is app.json's extra.eas.projectId (static JSON).
EXPO_PUBLIC_EAS_PROJECT_ID=
# 005, Settings -> "Delete account" row -- opens in the system browser.
# Placeholder policy page now, static deletion-request page later; a URL
# swap only, no build logic change.
EXPO_PUBLIC_DELETE_ACCOUNT_URL=https://example.com/skillcoach-delete-account
