# Copy to app/e2e/playwright/.env (gitignored) and fill in real values.
# Never commit the filled-in file.

# Same Supabase project as app/.env / api/.env -- no new project.
E2E_SUPABASE_URL=https://<project>.supabase.co
E2E_SUPABASE_ANON_KEY=
# Service-role key: same value as api/.env's SUPABASE_SERVICE_ROLE_KEY.
# Used ONLY by seed-test-users.ts (account creation) and support/db.ts's
# Postgres assertions (profiles/messages tables) -- never shipped to a
# browser context.
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Neo4j Aura: same instance api/.env's NEO4J_URI/NEO4J_USER/NEO4J_PASSWORD
# point at (copy those three values directly) -- or Render's dashboard
# (skillcoach-api service env vars) if api/.env doesn't have them on your
# machine.
E2E_NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
E2E_NEO4J_USER=neo4j
E2E_NEO4J_PASSWORD=

# Where the built web app is served during a Playwright run. Deliberately
# uncommon -- avoid 3000/8000/8081/etc, which other unrelated local dev
# servers on this machine may already be using (a real collision here once
# caused Playwright to silently test against a different project entirely;
# see playwright.config.ts's comment).
E2E_BASE_URL=http://localhost:4021

# Two dedicated, pre-confirmed test accounts (seed-test-users.ts creates
# these; safe to reuse across runs -- idempotent). Not your real account.
E2E_PW1_EMAIL=e2e-pw1@skillcoach.test
E2E_PW1_PASSWORD=
E2E_PW2_EMAIL=e2e-pw2@skillcoach.test
E2E_PW2_PASSWORD=

# Same value as app/.env's EXPO_PUBLIC_API_URL -- used by
# seed-test-users.ts to complete PW1/PW2's profile step directly via the
# API (idempotent), so specs can assume both accounts are past onboarding.
E2E_API_URL=http://localhost:8000
